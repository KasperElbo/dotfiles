#!/usr/bin/env bash
set -euo pipefail

# agent-worktree: create and tear down isolated Git worktrees for AI coding
# agents (Claude Code, Codex, FirstMate crewmates, or anything else) so
# parallel agent work never collides with the primary checkout or with
# another agent's worktree.
#
# Installed at ~/.local/bin/agent-worktree by common/install-ai.sh only when
# the optional AI profile is selected. Works in any Git repository regardless
# of how that repository itself was set up.
#
# This tool never pushes, merges, force-pushes, or deletes branches. Removing
# a worktree only removes the working copy; the branch is left in place
# unless you delete it yourself.

XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

usage() {
  cat <<'EOF'
Usage: agent-worktree <command> [arguments]

Commands:
  new <name> [<base-ref>]  Create worktree + branch "agents/<name>" from
                           <base-ref> (default: HEAD). Refuses if the branch
                           or worktree path already exists.
  list                     List worktrees this tool created for this repo.
  remove <name> [--force]  Remove a worktree. Refuses if it has uncommitted
                           changes, or commits that are neither pushed to an
                           upstream nor merged into another local branch,
                           unless --force is given. The branch itself is
                           never deleted; remove it yourself with
                           'git branch -D agents/<name>' once you are sure.
  prune                    Run 'git worktree prune' to clear stale metadata
                           for worktrees removed outside this tool.

Worktrees live under:
  $XDG_DATA_HOME/dotfiles/agent-worktrees/<repo-name>/<name>
EOF
}

die() {
  printf 'agent-worktree: %s\n' "$*" >&2
  exit 1
}

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null ||
    die "not inside a Git repository"
}

worktrees_root() {
  local root="$1"
  printf '%s/dotfiles/agent-worktrees/%s\n' "$XDG_DATA_HOME" "$(basename "$root")"
}

cmd_new() {
  local name="${1:-}"
  local base="${2:-HEAD}"

  [[ -n "$name" ]] || die "'new' requires a name"
  [[ "$name" =~ ^[A-Za-z0-9_.-]+$ ]] ||
    die "name must match [A-Za-z0-9_.-]+, got: $name"

  local root branch path
  root="$(repo_root)"
  branch="agents/$name"
  path="$(worktrees_root "$root")/$name"

  git -C "$root" show-ref --verify --quiet "refs/heads/$branch" &&
    die "branch $branch already exists; pick a different name or remove it first"

  [[ ! -e "$path" ]] || die "path already exists: $path"

  mkdir -p "$(dirname "$path")"
  git -C "$root" worktree add -b "$branch" "$path" "$base" >&2
  printf '%s\n' "$path"
}

cmd_list() {
  local root prefix
  root="$(repo_root)"
  prefix="$(worktrees_root "$root")/"
  git -C "$root" worktree list | grep -F "$prefix" || true
}

cmd_remove() {
  local name="${1:-}"
  local force="false"
  shift || true

  while (($#)); do
    case "$1" in
    --force)
      force="true"
      shift
      ;;
    *)
      die "remove: unknown option: $1"
      ;;
    esac
  done

  [[ -n "$name" ]] || die "'remove' requires a name"

  local root path
  root="$(repo_root)"
  path="$(worktrees_root "$root")/$name"

  [[ -e "$path" ]] || die "no worktree at $path"

  if [[ "$force" != "true" ]]; then
    [[ -z "$(git -C "$path" status --porcelain 2>/dev/null)" ]] ||
      die "$path has uncommitted changes; commit/discard them or use --force"

    local branch="agents/$name"
    local landed="false"

    if git -C "$path" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' \
      >/dev/null 2>&1; then
      [[ -z "$(git -C "$path" rev-list '@{upstream}..HEAD' 2>/dev/null)" ]] &&
        landed="true"
    fi

    if [[ "$landed" != "true" ]]; then
      local contained_in
      contained_in="$(
        git -C "$root" for-each-ref --format='%(refname:short)' \
          --contains "$branch" refs/heads/ 2>/dev/null | grep -vFx "$branch" || true
      )"
      [[ -n "$contained_in" ]] && landed="true"
    fi

    [[ "$landed" == "true" ]] ||
      die "$branch has commits that are neither pushed to an upstream nor" \
        "merged into another local branch; land the work first or use --force"
  fi

  if [[ "$force" == "true" ]]; then
    git -C "$root" worktree remove --force "$path"
  else
    git -C "$root" worktree remove "$path"
  fi

  printf 'Removed worktree: %s (branch agents/%s left in place)\n' "$path" "$name"
}

cmd_prune() {
  git -C "$(repo_root)" worktree prune -v
}

case "${1:-}" in
new)
  shift
  cmd_new "$@"
  ;;
list)
  shift
  cmd_list "$@"
  ;;
remove)
  shift
  cmd_remove "$@"
  ;;
prune)
  shift
  cmd_prune "$@"
  ;;
-h | --help | "")
  usage
  ;;
*)
  printf 'agent-worktree: unknown command: %s\n' "$1" >&2
  usage >&2
  exit 1
  ;;
esac
