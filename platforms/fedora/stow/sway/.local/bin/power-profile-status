#!/usr/bin/env bash
set -euo pipefail

profile=""
platform_profile_file="${PLATFORM_PROFILE_FILE:-/sys/firmware/acpi/platform_profile}"

if [[ -r "$platform_profile_file" ]]; then
  read -r profile <"$platform_profile_file" || true
fi

if [[ -z "$profile" ]] \
  && command -v asusctl >/dev/null 2>&1 \
  && output="$(asusctl profile get 2>/dev/null)"; then
  profile="$(
    printf '%s\n' "$output" \
      | sed -n 's/^Active profile: //p' \
      | head -n 1
  )"
fi

if [[ -z "$profile" ]] \
  && command -v powerprofilesctl >/dev/null 2>&1 \
  && profile="$(powerprofilesctl get 2>/dev/null)"; then
  :
fi

if [[ -z "$profile" ]]; then
  profile="unavailable"
fi

printf 'Power %s\n' "${profile:-unknown}"
