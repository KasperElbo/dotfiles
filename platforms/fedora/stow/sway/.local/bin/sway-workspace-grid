#!/usr/bin/env bash
set -euo pipefail

direction="${1:-}"

case "$direction" in
left | right | up | down)
  ;;
*)
  printf 'Usage: sway-workspace-grid {left|right|up|down}\n' >&2
  exit 2
  ;;
esac

current="$(swaymsg -t get_workspaces -r | jq -r '.[] | select(.focused).num')"

# Refusing matches aerospace-workspace-grid, which config/actions.tsv describes
# with the same sentence: a workspace outside the grid has no place in it, and
# silently landing the user somewhere they did not ask for is worse than saying
# so. The arithmetic below then forces base 10, as aerospace does, so the two
# scripts stay identical rather than relying on the pattern above to be the
# only thing standing between a leading zero and an octal read.
[[ "$current" =~ ^[1-9]$ ]] || {
  printf 'Focused workspace is not in the 1-9 grid: %s\n' "$current" >&2
  exit 1
}

workspace=$((10#$current))
index=$((workspace - 1))
row=$((index / 3))
column=$((index % 3))

case "$direction" in
left) column=$(((column + 2) % 3)) ;;
right) column=$(((column + 1) % 3)) ;;
up) row=$(((row + 2) % 3)) ;;
down) row=$(((row + 1) % 3)) ;;
esac

target=$((row * 3 + column + 1))
exec swaymsg workspace number "$target"
