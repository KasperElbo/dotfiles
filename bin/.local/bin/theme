#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: theme {latte|frappe|macchiato|mocha} [--preserve-wallpaper]

Options:
  --preserve-wallpaper  change the theme without replacing the desktop wallpaper
  -h, --help            show this help
EOF
}

flavour=""
preserve_wallpaper="false"

while (($#)); do
  case "$1" in
  --preserve-wallpaper)
    preserve_wallpaper="true"
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  -*)
    echo "Unknown option: $1" >&2
    usage >&2
    exit 2
    ;;
  *)
    if [[ -n "$flavour" ]]; then
      echo "Unexpected argument: $1" >&2
      usage >&2
      exit 2
    fi
    flavour="$1"
    ;;
  esac
  shift
done

case "$flavour" in
  latte|frappe|macchiato|mocha)
    ;;
  *)
    if [[ -n "$flavour" ]]; then
      echo "Invalid Catppuccin flavour: $flavour" >&2
    fi
    usage >&2
    exit 2
    ;;
esac

# Resolve the dotfiles repository from this script's symlink without GNU-only
# readlink flags: <repo>/bin/.local/bin/theme
script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  link_target="$(readlink "$script_path")"

  if [[ "$link_target" == /* ]]; then
    script_path="$link_target"
  else
    script_path="$script_dir/$link_target"
  fi
done

script_path="$(cd -P "$(dirname "$script_path")" && pwd)/$(basename "$script_path")"
repo_root="$(cd "$(dirname "$script_path")/../../.." && pwd)"
# shellcheck source=../../../common/lib/common.sh
source "$repo_root/common/lib/common.sh"
# shellcheck source=../../../common/lib/theme-state.sh
source "$repo_root/common/lib/theme-state.sh"

echo "Switching to Catppuccin $flavour..."

write_theme_state "$flavour"

# Reload an existing tmux server.
if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
  tmux source-file "$HOME/.tmux.conf"
fi

# Platform hooks may add desktop integration without putting platform checks
# in the portable command itself.
hook_dir="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/theme-hooks.d"
for hook in "$hook_dir"/*.sh; do
  [[ -r "$hook" ]] || continue
  # shellcheck source=/dev/null
  source "$hook"
done

echo
echo "Catppuccin $flavour selected."
echo "New Neovim instances will use catppuccin-$flavour."
