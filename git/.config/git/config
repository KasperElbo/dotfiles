[init]
    defaultBranch = main

[pull]
    rebase = false

[fetch]
    prune = true

[push]
    autoSetupRemote = true

[rerere]
    enabled = true

[diff]
    algorithm = histogram

[color]
    ui = auto

[sequence]
    editor = nvim

[core]
    pager = delta
    editor = nvim

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true

[merge]
    conflictStyle = zdiff3
	tool = nvimdiff

# Optional machine/user-specific configuration.
[include]
    path = ~/.config/git/local

# DR commit identity
[includeIf "hasconfig:remote.*.url:git@github.com:drdk/**"]
    path = ~/.config/git/drdk

# Theming
[include]
  path = ~/.config/git/themes/catppuccin.gitconfig

[include]
  path = ~/.config/dotfiles/git-theme
[mergetool "nvimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$MERGED\" \"$REMOTE\"
[mergetool]
	prompt = false
