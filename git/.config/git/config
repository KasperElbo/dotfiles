[init]
    defaultBranch = main

[pull]
    rebase = false

[fetch]
    prune = true

[push]
    autoSetupRemote = true

[rerere]
    enabled = true

[diff]
    algorithm = histogram

[color]
    ui = auto

# Optional machine/user-specific configuration.
[include]
   path = ~/.config/git/local

# DR commit identity
[includeIf "hasconfig:remote.*.url:git@github.com:drdk/**"]
    path = ~/.config/git/drdk

