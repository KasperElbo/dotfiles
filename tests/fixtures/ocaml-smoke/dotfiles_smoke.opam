opam-version: "2.0"
synopsis: "Disposable OCaml workflow smoke test"
maintainer: "dotfiles@example.invalid"
authors: "Dotfiles validation"
license: "MIT"
homepage: "https://example.invalid/dotfiles-smoke"
bug-reports: "https://example.invalid/dotfiles-smoke/issues"
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.12"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
run-test: [
  ["dune" "runtest" "-p" name]
]
