/git/.config/git/local
/git/.config/git/drdk

# Python bytecode; regenerated by the interpreter and embeds the source's
# mtime, so it is never meaningful to commit (scripts/validate-repository-hygiene.py
# also rejects a tracked one).
__pycache__/
*.pyc

# OCaml/Dune build artifacts
_build/
*.install

# Cheat sheet LaTeX build output (docs/cheatsheets/generate.sh); the tracked
# .tex source is the source of truth, not these regenerable derived files.
docs/cheatsheets/*.pdf
docs/cheatsheets/*.aux
docs/cheatsheets/*.log
docs/cheatsheets/*.fls
docs/cheatsheets/*.fdb_latexmk
docs/cheatsheets/*.synctex.gz
